# =====================================================================
# CashFlow Protocol - Environment Configuration Template
# =====================================================================
# Copy this file to .env to set your private keys and credentials safely.
# No API keys or credentials are ever rendered in the app UI.
# =====================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="https://my-app-id.run.app"

# Direct Google OAuth 2.0 Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
VITE_GOOGLE_CLIENT_ID=""

# Google OAuth 2.0 Client Secret / Key
GOOGLE_CLIENT_SECRET=""
